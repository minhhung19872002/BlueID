# BlueID development settings (NOT secret: dev only, test domains only; see docs/00 D9).
BID_DB_USER=blueid
BID_DB_PASSWORD=blueid-dev-pass
BID_DB_NAME=blueid
BID_DEV_PG_PORT=54432
BID_DEV_VALKEY_PORT=54379
BID_DEV_MAIL_UI_PORT=54025
BID_DEV_MAIL_SMTP_PORT=54026
BID_DEV_KEYCLOAK_PORT=54080
BID_DEV_LDAP_PORT=54389
BID_DEV_HTTPS_PORT=54443
BID_ISSUER=https://id.blue.test:54443
BID_KEYCLOAK_ADMIN=admin
BID_KEYCLOAK_ADMIN_PASSWORD=keycloak-dev-pass
BID_LDAP_ADMIN_PASSWORD=ldap-dev-pass
BID_LDAP_USERS=10000
# Host-run processes (scripts/dev-run.sh) reach PostgreSQL through its published port.
BID_DB_HOST=127.0.0.1
BID_DB_PORT=54432
BID_PLATFORM_DOMAIN=blue.test
BID_PLATFORM_ADMIN_UPN=admin@blue.test
BID_PLATFORM_ADMIN_PASSWORD=Platform-Dev-Pass-2026
BID_SEED_SAMPLE_DATA=true
BID_SEED_USER_PASSWORD=Sample-User-Pass-2026
# Phase 2 (OAuth/OIDC). Master key: encrypts signing keys at rest, derives OpenIddict's encryption key (dev only).
BID_MASTER_KEY=VqC8QUg6RpM7alV8WJ2somczymJiuoAFiz5FUKcx9wU=
BID_RESOURCE_MAIL=https://api.mail.blue.test
BID_RESOURCE_CHAT=https://api.chat.blue.test
BID_SAMPLE_URL=https://sample.blue.test:54443
# Host-run processes reach the dev domains through Caddy on 127.0.0.1 (no hosts-file edit needed; Development only).
BID_DEV_HOSTS=id.blue.test=127.0.0.1,sample.blue.test=127.0.0.1,localhost.emobix.co.uk=127.0.0.1
# OpenID conformance suite (docs/00 D14): dev and CI only, never in production.
BID_CONFORMANCE_MODE=true
BID_CONFORMANCE_USER_PASSWORD=Conformance-User-Pass-2026
BID_CONFORMANCE_CLIENT1_SECRET=conformance-client-1-secret-e93bb51407166f18
BID_CONFORMANCE_CLIENT2_SECRET=conformance-client-2-secret-630f3b5f27ca515b
# Sample product (samples/SampleProduct)
SAMPLE_AUTHORITY=https://id.blue.test:54443/
SAMPLE_API=https://sample.blue.test:54443/api
SAMPLE_CLIENT_ID=sample-product
SAMPLE_KEY_ID=sample-dev-1
SAMPLE_DEV_HOSTS=id.blue.test=127.0.0.1
