# Production front: TLS (automatic certificates) for BID_HOST; API paths to the api service, the rest to web.
{
	email {$BID_ACME_EMAIL}
}

{$BID_HOST} {
	encode zstd gzip
	@api path /directory /directory/* /admin/v1 /admin/v1/* /me/v1 /me/v1/* /internal/v1/* /scim/*
	handle @api {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
