# Copy to deploy/.env and fill in. Never commit the filled file (git-ignored).
BID_IMAGE_TAG=
BID_HOST=id.example.com
BID_ACME_EMAIL=ops@example.com
BID_DB_USER=blueid
BID_DB_PASSWORD=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts signing keys and the cookie key ring at rest. Back it up
# separately from the database (docs/03); never commit it.
BID_MASTER_KEY=
BID_PLATFORM_DOMAIN=example.com
BID_PLATFORM_ADMIN_UPN=admin@example.com
BID_PLATFORM_ADMIN_PASSWORD=
