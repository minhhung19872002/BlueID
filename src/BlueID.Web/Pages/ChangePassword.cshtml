@page "/password/change"
@model ChangePasswordModel
@{
    ViewData["Title"] = T["change_password.title"].Value;
}
<h1 id="page-title">@T["change_password.title"]</h1>
<p>@T["change_password.intro"]</p>
@if (Model.ErrorKey is not null)
{
    <p class="alert" role="alert" id="cp-error">@T[Model.ErrorKey]</p>
}
<form method="post" novalidate>
    <input type="hidden" name="t" value="@Model.Token">
    <label for="NewPassword">@T["change_password.new"]</label>
    <input id="NewPassword" name="NewPassword" type="password" autocomplete="new-password" required autofocus minlength="12" aria-describedby="pw-hint">
    <p class="hint" id="pw-hint">@T["change_password.hint"]</p>
    <label for="ConfirmPassword">@T["change_password.confirm"]</label>
    <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required>
    <button type="submit">@T["change_password.submit"]</button>
</form>
