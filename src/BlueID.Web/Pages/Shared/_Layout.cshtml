@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var dir = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
    var path = Context.Request.Path.Value ?? "/";
    string LangLink(string l)
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Context.Request.QueryString.Value)
            .Where(kv => kv.Key != "ui_locales").ToDictionary(kv => kv.Key, kv => (string?)kv.Value.ToString());
        q["ui_locales"] = l;
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(path, q);
    }
}
<!doctype html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>@ViewData["Title"] · BlueID</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<main class="shell">
    <section class="card" aria-labelledby="page-title">
        <header class="brand">
            <span class="logo" aria-hidden="true">B</span>
            <span class="brand-name">BlueID</span>
        </header>
        @RenderBody()
    </section>
    <footer class="foot">
        <nav aria-label="@T["layout.language"]">
            <a href="@LangLink("en")" lang="en" hreflang="en" aria-current="@(lang == "en" ? "true" : null)">English</a>
            <a href="@LangLink("vi")" lang="vi" hreflang="vi" aria-current="@(lang == "vi" ? "true" : null)">Tiếng Việt</a>
        </nav>
    </footer>
</main>
</body>
</html>
